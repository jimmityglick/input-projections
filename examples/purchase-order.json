{
  "version": "1.0.0",
  "root": {
    "id": "purchase_root",
    "kind": "Struct",
    "required": ["customer_id", "items", "payment"],
    "fields": {
      "customer_id": {
        "id": "cust_ref",
        "kind": "Reference",
        "target": "Customer",
        "required": true
      },
      "items": {
        "id": "lines",
        "kind": "List",
        "minItems": 1,
        "maxItems": 10,
        "item": {
          "id": "line_item",
          "kind": "Struct",
          "required": ["sku", "qty"],
          "fields": {
            "sku": { 
                "id": "sku_val", 
                "kind": "Scalar", 
                "required": true, 
                "scalar": { "type": "string" } 
            },
            "qty": { 
                "id": "qty_val", 
                "kind": "Scalar", 
                "required": true, 
                "scalar": { "type": "number", "min": 1 } 
            }
          }
        }
      },
      "payment": {
        "id": "pay_union",
        "kind": "Union",
        "discriminator": "method",
        "default": "cash",
        "variants": {
          "cash": {
            "id": "cash_opt",
            "kind": "Scalar",
            "required": false,
            "scalar": { "type": "null" }
          },
          "card": {
            "id": "card_struct",
            "kind": "Struct",
            "required": ["number"],
            "fields": {
              "number": {
                "id": "cc_num",
                "kind": "Scalar",
                "required": true,
                "scalar": { "type": "string", "minLength": 16 }
              }
            }
          }
        }
      }
    }
  }
}
