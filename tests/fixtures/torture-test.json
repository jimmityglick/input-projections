{
  "version": "1.0.0",
  "meta": {
    "label": "Torture Test",
    "description": "Maximum structural complexity: every legal combination of nesting, all primitives, all constraints"
  },
  "root": {
    "id": "torture_root",
    "kind": "Struct",
    "meta": { "label": "Torture Test Root" },
    "required": ["branch_a", "branch_b", "limits"],
    "fields": {
      "branch_a": {
        "id": "branch_a",
        "kind": "List",
        "meta": { "label": "Branch A: Deep Alternating Nesting" },
        "minItems": 1,
        "maxItems": 5,
        "item": {
          "id": "a_item",
          "kind": "Union",
          "discriminator": "depth1",
          "meta": { "label": "Depth 1 Choice" },
          "variants": {
            "terminate": {
              "id": "a_terminate",
              "kind": "Scalar",
              "meta": { "label": "Stop Here" },
              "scalar": { "type": "null" }
            },
            "descend": {
              "id": "a_descend",
              "kind": "Struct",
              "meta": { "label": "Go Deeper" },
              "required": ["depth2_choice"],
              "fields": {
                "depth2_choice": {
                  "id": "depth2_choice",
                  "kind": "Union",
                  "discriminator": "depth2",
                  "meta": { "label": "Depth 2 Choice" },
                  "variants": {
                    "value": {
                      "id": "d2_value",
                      "kind": "Scalar",
                      "meta": { "label": "Number Value" },
                      "required": true,
                      "scalar": { "type": "number", "min": 0, "max": 100 }
                    },
                    "nested_list": {
                      "id": "d2_nested_list",
                      "kind": "List",
                      "meta": { "label": "Depth 3 List" },
                      "minItems": 0,
                      "maxItems": 3,
                      "uniqueItems": true,
                      "item": {
                        "id": "d3_item",
                        "kind": "Union",
                        "discriminator": "depth3",
                        "meta": { "label": "Depth 3 Choice" },
                        "variants": {
                          "leaf": {
                            "id": "d3_leaf",
                            "kind": "Scalar",
                            "meta": { "label": "Leaf String" },
                            "required": true,
                            "scalar": { "type": "string", "enum": ["alpha", "beta", "gamma", "delta"] }
                          },
                          "branch": {
                            "id": "d3_branch",
                            "kind": "Struct",
                            "meta": { "label": "Depth 4 Struct" },
                            "required": ["depth4_union"],
                            "fields": {
                              "depth4_union": {
                                "id": "depth4_union",
                                "kind": "Union",
                                "discriminator": "depth4",
                                "meta": { "label": "Depth 4 Choice" },
                                "variants": {
                                  "bool_val": {
                                    "id": "d4_bool",
                                    "kind": "Scalar",
                                    "meta": { "label": "Boolean" },
                                    "scalar": { "type": "boolean" }
                                  },
                                  "final_struct": {
                                    "id": "d4_final",
                                    "kind": "Struct",
                                    "meta": { "label": "Depth 5 Final" },
                                    "required": ["code"],
                                    "fields": {
                                      "code": {
                                        "id": "d5_code",
                                        "kind": "Scalar",
                                        "meta": { "label": "Code" },
                                        "required": true,
                                        "scalar": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{3}$" }
                                      },
                                      "depth5_choice": {
                                        "id": "depth5_choice",
                                        "kind": "Union",
                                        "discriminator": "depth5",
                                        "meta": { "label": "Depth 5 Choice" },
                                        "default": "none",
                                        "variants": {
                                          "none": {
                                            "id": "d5_none",
                                            "kind": "Scalar",
                                            "scalar": { "type": "null" }
                                          },
                                          "final_list": {
                                            "id": "d5_final_list",
                                            "kind": "List",
                                            "meta": { "label": "Depth 6 List" },
                                            "minItems": 1,
                                            "maxItems": 2,
                                            "item": {
                                              "id": "d6_item",
                                              "kind": "Union",
                                              "discriminator": "depth6",
                                              "meta": { "label": "Depth 6 Choice" },
                                              "variants": {
                                                "num": {
                                                  "id": "d6_num",
                                                  "kind": "Scalar",
                                                  "meta": { "label": "Final Number" },
                                                  "scalar": { "type": "number", "min": -999, "max": 999, "multipleOf": 0.5 }
                                                },
                                                "txt": {
                                                  "id": "d6_txt",
                                                  "kind": "Scalar",
                                                  "meta": { "label": "Final Text" },
                                                  "scalar": { "type": "string", "minLength": 1, "maxLength": 50 }
                                                },
                                                "deep_struct": {
                                                  "id": "d6_deep_struct",
                                                  "kind": "Struct",
                                                  "meta": { "label": "Depth 7 Struct" },
                                                  "required": ["terminus"],
                                                  "fields": {
                                                    "terminus": {
                                                      "id": "d7_terminus",
                                                      "kind": "Union",
                                                      "discriminator": "terminus",
                                                      "meta": { "label": "Depth 7 Terminus" },
                                                      "variants": {
                                                        "end_a": {
                                                          "id": "terminus_a",
                                                          "kind": "Scalar",
                                                          "meta": { "label": "Terminus A" },
                                                          "scalar": { "type": "string", "enum": ["DONE_A"] }
                                                        },
                                                        "end_b": {
                                                          "id": "terminus_b",
                                                          "kind": "Scalar",
                                                          "meta": { "label": "Terminus B" },
                                                          "scalar": { "type": "boolean", "enum": [true] }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "branch_b": {
        "id": "branch_b",
        "kind": "Struct",
        "meta": { "label": "Branch B: Sibling Unions + Relations" },
        "required": ["mode_x", "mode_y", "val_low", "val_high"],
        "fields": {
          "mode_x": {
            "id": "mode_x",
            "kind": "Union",
            "discriminator": "x_type",
            "meta": { "label": "Mode X" },
            "variants": {
              "off": {
                "id": "x_off",
                "kind": "Scalar",
                "meta": { "label": "Off" },
                "scalar": { "type": "null" }
              },
              "simple": {
                "id": "x_simple",
                "kind": "Scalar",
                "meta": { "label": "Simple String" },
                "required": true,
                "scalar": { "type": "string", "minLength": 1 }
              },
              "complex": {
                "id": "x_complex",
                "kind": "Struct",
                "meta": { "label": "Complex X" },
                "required": ["x_val"],
                "fields": {
                  "x_val": {
                    "id": "x_val",
                    "kind": "Scalar",
                    "meta": { "label": "X Value" },
                    "required": true,
                    "scalar": { "type": "number" }
                  },
                  "x_tags": {
                    "id": "x_tags",
                    "kind": "List",
                    "meta": { "label": "X Tags" },
                    "minItems": 0,
                    "maxItems": 5,
                    "uniqueItems": true,
                    "item": {
                      "id": "x_tag",
                      "kind": "Scalar",
                      "meta": { "label": "Tag" },
                      "required": true,
                      "scalar": { "type": "string", "pattern": "^[a-z]+$" }
                    }
                  }
                }
              }
            }
          },
          "mode_y": {
            "id": "mode_y",
            "kind": "Union",
            "discriminator": "y_type",
            "meta": { "label": "Mode Y" },
            "variants": {
              "disabled": {
                "id": "y_disabled",
                "kind": "Scalar",
                "meta": { "label": "Disabled" },
                "scalar": { "type": "boolean", "enum": [false] }
              },
              "enabled": {
                "id": "y_enabled",
                "kind": "Struct",
                "meta": { "label": "Enabled Y" },
                "required": ["y_ref", "y_choice"],
                "fields": {
                  "y_ref": {
                    "id": "y_ref",
                    "kind": "Reference",
                    "meta": { "label": "Y Reference" },
                    "target": "ExternalY",
                    "required": true,
                    "format": { "pattern": "^Y-[0-9]{4}$" }
                  },
                  "y_choice": {
                    "id": "y_choice",
                    "kind": "Union",
                    "discriminator": "y_sub",
                    "meta": { "label": "Y Sub-choice" },
                    "variants": {
                      "alpha": {
                        "id": "y_alpha",
                        "kind": "Scalar",
                        "meta": { "label": "Alpha" },
                        "scalar": { "type": "string", "enum": ["one", "two", "three"] }
                      },
                      "beta": {
                        "id": "y_beta",
                        "kind": "List",
                        "meta": { "label": "Beta List" },
                        "minItems": 1,
                        "maxItems": 3,
                        "item": {
                          "id": "beta_item",
                          "kind": "Struct",
                          "meta": { "label": "Beta Item" },
                          "required": ["beta_a", "beta_b"],
                          "fields": {
                            "beta_a": {
                              "id": "beta_a",
                              "kind": "Scalar",
                              "meta": { "label": "Beta A" },
                              "required": true,
                              "scalar": { "type": "number", "min": 0 }
                            },
                            "beta_b": {
                              "id": "beta_b",
                              "kind": "Scalar",
                              "meta": { "label": "Beta B" },
                              "required": true,
                              "scalar": { "type": "number", "min": 0 }
                            }
                          },
                          "relations": [
                            { "op": "lte", "left": "beta_a", "right": "beta_b", "label": "A must be <= B" }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "val_low": {
            "id": "val_low",
            "kind": "Scalar",
            "meta": { "label": "Low Value" },
            "required": true,
            "scalar": { "type": "number", "min": 0, "max": 1000 }
          },
          "val_high": {
            "id": "val_high",
            "kind": "Scalar",
            "meta": { "label": "High Value" },
            "required": true,
            "scalar": { "type": "number", "min": 0, "max": 1000 }
          }
        },
        "relations": [
          { "op": "lt", "left": "val_low", "right": "val_high", "label": "Low must be < High" }
        ]
      },
      "branch_c": {
        "id": "branch_c",
        "kind": "Union",
        "discriminator": "c_mode",
        "meta": { "label": "Branch C: Union with List Variant" },
        "default": "single",
        "variants": {
          "single": {
            "id": "c_single",
            "kind": "Struct",
            "meta": { "label": "Single Item" },
            "required": ["item_id"],
            "fields": {
              "item_id": {
                "id": "c_item_id",
                "kind": "Reference",
                "meta": { "label": "Item Reference" },
                "target": "Item",
                "required": true,
                "format": { "pattern": "^ITEM-[A-Z0-9]{8}$" }
              }
            }
          },
          "batch": {
            "id": "c_batch",
            "kind": "List",
            "meta": { "label": "Batch of Items" },
            "minItems": 2,
            "maxItems": 10,
            "item": {
              "id": "batch_item",
              "kind": "Struct",
              "meta": { "label": "Batch Entry" },
              "required": ["entry_type"],
              "fields": {
                "entry_type": {
                  "id": "entry_type",
                  "kind": "Union",
                  "discriminator": "type",
                  "meta": { "label": "Entry Type" },
                  "variants": {
                    "standard": {
                      "id": "entry_standard",
                      "kind": "Struct",
                      "meta": { "label": "Standard Entry" },
                      "required": ["qty"],
                      "fields": {
                        "qty": {
                          "id": "std_qty",
                          "kind": "Scalar",
                          "meta": { "label": "Quantity" },
                          "required": true,
                          "scalar": { "type": "number", "min": 1, "max": 999, "multipleOf": 1 }
                        },
                        "note": {
                          "id": "std_note",
                          "kind": "Scalar",
                          "meta": { "label": "Note" },
                          "scalar": { "type": "string", "maxLength": 200 }
                        }
                      }
                    },
                    "special": {
                      "id": "entry_special",
                      "kind": "Struct",
                      "meta": { "label": "Special Entry" },
                      "required": ["code", "priority"],
                      "fields": {
                        "code": {
                          "id": "special_code",
                          "kind": "Scalar",
                          "meta": { "label": "Special Code" },
                          "required": true,
                          "scalar": { "type": "string", "pattern": "^SP-[0-9]{3}$" }
                        },
                        "priority": {
                          "id": "special_priority",
                          "kind": "Scalar",
                          "meta": { "label": "Priority" },
                          "required": true,
                          "scalar": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
                        },
                        "flags": {
                          "id": "special_flags",
                          "kind": "List",
                          "meta": { "label": "Flags" },
                          "minItems": 0,
                          "maxItems": 4,
                          "uniqueItems": true,
                          "item": {
                            "id": "flag_item",
                            "kind": "Scalar",
                            "meta": { "label": "Flag" },
                            "required": true,
                            "scalar": { "type": "string", "enum": ["urgent", "reviewed", "approved", "archived"] }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "branch_d": {
        "id": "branch_d",
        "kind": "Reference",
        "meta": { "label": "Branch D: Top-Level Reference" },
        "target": "MasterEntity",
        "required": true,
        "format": { "pattern": "^MASTER-[A-F0-9]{12}$" }
      },
      "limits": {
        "id": "limits",
        "kind": "Struct",
        "meta": { "label": "Limits: Multi-Relation Struct" },
        "required": ["min_bound", "max_bound", "target_val", "tolerance"],
        "fields": {
          "min_bound": {
            "id": "min_bound",
            "kind": "Scalar",
            "meta": { "label": "Minimum Bound" },
            "required": true,
            "scalar": { "type": "number" }
          },
          "max_bound": {
            "id": "max_bound",
            "kind": "Scalar",
            "meta": { "label": "Maximum Bound" },
            "required": true,
            "scalar": { "type": "number" }
          },
          "target_val": {
            "id": "target_val",
            "kind": "Scalar",
            "meta": { "label": "Target Value" },
            "required": true,
            "scalar": { "type": "number" }
          },
          "tolerance": {
            "id": "tolerance",
            "kind": "Scalar",
            "meta": { "label": "Tolerance" },
            "required": true,
            "scalar": { "type": "number", "min": 0 }
          }
        },
        "relations": [
          { "op": "lte", "left": "min_bound", "right": "max_bound", "label": "Min must be <= Max" },
          { "op": "gte", "left": "target_val", "right": "min_bound", "label": "Target must be >= Min" },
          { "op": "lte", "left": "target_val", "right": "max_bound", "label": "Target must be <= Max" }
        ]
      },
      "all_scalars": {
        "id": "all_scalars",
        "kind": "Struct",
        "meta": { "label": "All Scalar Types Demo" },
        "fields": {
          "string_plain": {
            "id": "str_plain",
            "kind": "Scalar",
            "meta": { "label": "Plain String" },
            "scalar": { "type": "string" }
          },
          "string_constrained": {
            "id": "str_constrained",
            "kind": "Scalar",
            "meta": { "label": "Constrained String" },
            "scalar": { "type": "string", "pattern": "^[a-z]{3,10}$", "minLength": 3, "maxLength": 10 }
          },
          "string_enum": {
            "id": "str_enum",
            "kind": "Scalar",
            "meta": { "label": "Enum String" },
            "scalar": { "type": "string", "enum": ["option_a", "option_b", "option_c"] }
          },
          "number_plain": {
            "id": "num_plain",
            "kind": "Scalar",
            "meta": { "label": "Plain Number" },
            "scalar": { "type": "number" }
          },
          "number_constrained": {
            "id": "num_constrained",
            "kind": "Scalar",
            "meta": { "label": "Constrained Number" },
            "scalar": { "type": "number", "min": -100, "max": 100, "multipleOf": 0.25 }
          },
          "boolean_plain": {
            "id": "bool_plain",
            "kind": "Scalar",
            "meta": { "label": "Plain Boolean" },
            "scalar": { "type": "boolean" }
          },
          "boolean_forced_true": {
            "id": "bool_true",
            "kind": "Scalar",
            "meta": { "label": "Must Be True" },
            "scalar": { "type": "boolean", "enum": [true] }
          },
          "null_val": {
            "id": "null_val",
            "kind": "Scalar",
            "meta": { "label": "Null Value" },
            "scalar": { "type": "null" }
          }
        }
      }
    }
  }
}
