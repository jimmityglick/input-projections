{
  "version": "1.0.0",
  "meta": {
    "label": "Grid (Row Union)",
    "description": "A grid-shaped projection with per-row union field for testing conditional columns"
  },
  "root": {
    "id": "grid_list",
    "kind": "List",
    "minItems": 0,
    "maxItems": 500,
    "meta": {
      "label": "Data Grid"
    },
    "item": {
      "id": "grid_row",
      "kind": "Struct",
      "required": ["row_id", "title", "status"],
      "fields": {
        "row_id": {
          "id": "row_id",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "Row ID",
            "hint": "Stable primary key"
          },
          "scalar": {
            "type": "string",
            "pattern": "^row_[0-9]{4}$",
            "minLength": 8,
            "maxLength": 8
          }
        },
        "title": {
          "id": "row_title",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "Title"
          },
          "scalar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "status": {
          "id": "row_status",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "Status"
          },
          "scalar": {
            "type": "string",
            "enum": ["new", "in_progress", "blocked", "done"]
          }
        },
        "owner_id": {
          "id": "row_owner",
          "kind": "Reference",
          "target": "User",
          "meta": {
            "label": "Owner"
          },
          "format": {
            "pattern": "^user_[0-9]{3}$",
            "minLength": 8,
            "maxLength": 8
          }
        },
        "entity": {
          "id": "row_entity",
          "kind": "Union",
          "discriminator": "type",
          "default": "person",
          "meta": {
            "label": "Entity"
          },
          "variants": {
            "person": {
              "id": "entity_person",
              "kind": "Struct",
              "required": ["first_name", "last_name"],
              "fields": {
                "first_name": {
                  "id": "person_first_name",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "First Name"
                  },
                  "scalar": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                },
                "last_name": {
                  "id": "person_last_name",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Last Name"
                  },
                  "scalar": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                },
                "email": {
                  "id": "person_email",
                  "kind": "Scalar",
                  "meta": {
                    "label": "Email"
                  },
                  "scalar": {
                    "type": "string",
                    "pattern": "^[^@]+@[^@]+\\.[^@]+$",
                    "maxLength": 100
                  }
                },
                "customer_id": {
                  "id": "person_customer",
                  "kind": "Reference",
                  "target": "Customer",
                  "meta": {
                    "label": "Customer ID"
                  },
                  "format": {
                    "pattern": "^cust_[0-9]{4}$",
                    "minLength": 9,
                    "maxLength": 9
                  }
                }
              }
            },
            "company": {
              "id": "entity_company",
              "kind": "Struct",
              "required": ["company_name"],
              "fields": {
                "company_name": {
                  "id": "company_name",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Company Name"
                  },
                  "scalar": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "tax_id": {
                  "id": "company_tax_id",
                  "kind": "Scalar",
                  "meta": {
                    "label": "Tax ID"
                  },
                  "scalar": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}[0-9]{8}$",
                    "minLength": 10,
                    "maxLength": 10
                  }
                },
                "contact_email": {
                  "id": "company_contact_email",
                  "kind": "Scalar",
                  "meta": {
                    "label": "Contact Email"
                  },
                  "scalar": {
                    "type": "string",
                    "pattern": "^[^@]+@[^@]+\\.[^@]+$",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
