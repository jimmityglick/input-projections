{
  "version": "1.0.0",
  "meta": {
    "label": "Password Registration",
    "description": "User registration form with password confirmation"
  },
  "root": {
    "id": "registration_form",
    "kind": "Struct",
    "fields": {
      "username": {
        "id": "username",
        "kind": "Scalar",
        "required": true,
        "scalar": { "type": "string", "minLength": 3, "maxLength": 32 }
      },
      "email": {
        "id": "email",
        "kind": "Scalar",
        "required": true,
        "scalar": { "type": "string", "pattern": "^[^@]+@[^@]+$" }
      },
      "password": {
        "id": "password",
        "kind": "Scalar",
        "required": true,
        "scalar": { "type": "string", "minLength": 8, "maxLength": 128 }
      },
      "confirm_password": {
        "id": "confirm_password",
        "kind": "Scalar",
        "required": true,
        "scalar": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "required": ["username", "email", "password", "confirm_password"],
    "relations": [
      {
        "op": "eq",
        "left": "password",
        "right": "confirm_password",
        "label": "Passwords must match"
      }
    ]
  }
}
