{
  "version": "1.0.0",
  "meta": {
    "label": "Grid (Full Power)",
    "description": "Demonstrates meta.layout=\"grid\" with mixed scalar types, reference enums, and conditional union columns"
  },
  "root": {
    "id": "work_items",
    "kind": "List",
    "minItems": 0,
    "maxItems": 500,
    "meta": {
      "label": "Work Items",
      "layout": "grid"
    },
    "item": {
      "id": "work_item",
      "kind": "Struct",
      "required": ["id", "title", "status", "priority", "owner_id", "details"],
      "fields": {
        "id": {
          "id": "work_item_id",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "ID",
            "hint": "Stable key"
          },
          "scalar": {
            "type": "string",
            "pattern": "^WI-[0-9]{4}$",
            "minLength": 7,
            "maxLength": 7
          }
        },
        "title": {
          "id": "work_item_title",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "Title"
          },
          "scalar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "status": {
          "id": "work_item_status",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "Status"
          },
          "scalar": {
            "type": "string",
            "enum": ["new", "triage", "in_progress", "blocked", "done"]
          }
        },
        "priority": {
          "id": "work_item_priority",
          "kind": "Scalar",
          "required": true,
          "meta": {
            "label": "Priority"
          },
          "scalar": {
            "type": "number",
            "min": 0,
            "max": 3,
            "multipleOf": 1
          }
        },
        "points": {
          "id": "work_item_points",
          "kind": "Scalar",
          "meta": {
            "label": "Points"
          },
          "scalar": {
            "type": "number",
            "min": 0,
            "max": 40,
            "multipleOf": 0.5
          }
        },
        "blocked": {
          "id": "work_item_blocked",
          "kind": "Scalar",
          "meta": {
            "label": "Blocked"
          },
          "scalar": {
            "type": "boolean"
          }
        },
        "owner_id": {
          "id": "work_item_owner",
          "kind": "Reference",
          "target": "User",
          "required": true,
          "meta": {
            "label": "Owner"
          },
          "format": {
            "pattern": "^user_[0-9]{3}$",
            "minLength": 8,
            "maxLength": 8,
            "enum": [
              "user_000",
              "user_001",
              "user_002",
              "user_003",
              "user_004",
              "user_005",
              "user_006",
              "user_007",
              "user_008",
              "user_009",
              "user_010",
              "user_011"
            ]
          }
        },
        "team_id": {
          "id": "work_item_team",
          "kind": "Reference",
          "target": "Team",
          "meta": {
            "label": "Team"
          },
          "format": {
            "pattern": "^team_[A-Z]{3}$",
            "minLength": 8,
            "maxLength": 8
          }
        },
        "due_date": {
          "id": "work_item_due_date",
          "kind": "Scalar",
          "meta": {
            "label": "Due Date"
          },
          "scalar": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "minLength": 10,
            "maxLength": 10
          }
        },
        "details": {
          "id": "work_item_details",
          "kind": "Union",
          "discriminator": "kind",
          "default": "bug",
          "meta": {
            "label": "Details"
          },
          "variants": {
            "bug": {
              "id": "details_bug",
              "kind": "Struct",
              "required": ["severity", "repro", "component"],
              "fields": {
                "severity": {
                  "id": "bug_severity",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Severity"
                  },
                  "scalar": {
                    "type": "string",
                    "enum": ["p0", "p1", "p2", "p3"]
                  }
                },
                "repro": {
                  "id": "bug_repro",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Repro"
                  },
                  "scalar": {
                    "type": "boolean"
                  }
                },
                "component": {
                  "id": "bug_component",
                  "kind": "Reference",
                  "target": "Component",
                  "required": true,
                  "meta": {
                    "label": "Component"
                  },
                  "format": {
                    "enum": ["comp_ui", "comp_api", "comp_data", "comp_auth"]
                  }
                },
                "ticket": {
                  "id": "bug_ticket",
                  "kind": "Reference",
                  "target": "Ticket",
                  "meta": {
                    "label": "Ticket"
                  },
                  "format": {
                    "pattern": "^TKT-[0-9]{5}$",
                    "minLength": 9,
                    "maxLength": 9
                  }
                },
                "notes": {
                  "id": "bug_notes",
                  "kind": "Scalar",
                  "meta": {
                    "label": "Notes"
                  },
                  "scalar": {
                    "type": "string",
                    "maxLength": 120
                  }
                }
              }
            },
            "feature": {
              "id": "details_feature",
              "kind": "Struct",
              "required": ["area", "effort_points", "customer_visible"],
              "fields": {
                "area": {
                  "id": "feature_area",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Area"
                  },
                  "scalar": {
                    "type": "string",
                    "enum": ["ui", "api", "data", "docs"]
                  }
                },
                "effort_points": {
                  "id": "feature_effort_points",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Effort"
                  },
                  "scalar": {
                    "type": "number",
                    "min": 1,
                    "max": 13,
                    "multipleOf": 1
                  }
                },
                "epic_id": {
                  "id": "feature_epic_id",
                  "kind": "Reference",
                  "target": "Epic",
                  "meta": {
                    "label": "Epic"
                  },
                  "format": {
                    "pattern": "^EPIC-[0-9]{4}$",
                    "minLength": 9,
                    "maxLength": 9
                  }
                },
                "customer_visible": {
                  "id": "feature_customer_visible",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Customer Visible"
                  },
                  "scalar": {
                    "type": "boolean"
                  }
                },
                "requester_id": {
                  "id": "feature_requester_id",
                  "kind": "Reference",
                  "target": "Customer",
                  "meta": {
                    "label": "Requester"
                  },
                  "format": {
                    "pattern": "^cust_[0-9]{4}$",
                    "minLength": 9,
                    "maxLength": 9
                  }
                }
              }
            },
            "ops": {
              "id": "details_ops",
              "kind": "Struct",
              "required": ["environment", "action", "scheduled"],
              "fields": {
                "environment": {
                  "id": "ops_environment",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Env"
                  },
                  "scalar": {
                    "type": "string",
                    "enum": ["dev", "staging", "prod"]
                  }
                },
                "action": {
                  "id": "ops_action",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Action"
                  },
                  "scalar": {
                    "type": "string",
                    "enum": ["reindex", "restart", "vacuum", "rotate_keys"]
                  }
                },
                "scheduled": {
                  "id": "ops_scheduled",
                  "kind": "Scalar",
                  "required": true,
                  "meta": {
                    "label": "Scheduled"
                  },
                  "scalar": {
                    "type": "boolean"
                  }
                },
                "runbook_id": {
                  "id": "ops_runbook",
                  "kind": "Reference",
                  "target": "Runbook",
                  "meta": {
                    "label": "Runbook"
                  },
                  "format": {
                    "pattern": "^RBK-[0-9]{4}$",
                    "minLength": 8,
                    "maxLength": 8
                  }
                },
                "oncall_id": {
                  "id": "ops_oncall",
                  "kind": "Reference",
                  "target": "User",
                  "meta": {
                    "label": "Oncall"
                  },
                  "format": {
                    "pattern": "^user_[0-9]{3}$",
                    "minLength": 8,
                    "maxLength": 8
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
