{
  "valid_minimal": {
    "version": "1.0.0",
    "root": {
      "kind": "Scalar",
      "scalar": { "type": "string" }
    }
  },

  "valid_deep_mixed_primitives": {
    "version": "1.2.3",
    "meta": { "label": "Top-level meta", "tags": ["demo", "schema"] },
    "root": {
      "id": "person_projection",
      "meta": { "label": "Person", "description": "A person capture projection" },
      "kind": "Struct",
      "fields": {
        "name": {
          "kind": "Struct",
          "fields": {
            "first": {
              "kind": "Scalar",
              "required": true,
              "scalar": { "type": "string", "minLength": 1 }
            },
            "last": {
              "kind": "Scalar",
              "required": true,
              "scalar": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["first", "last"]
        },
        "age": {
          "kind": "Scalar",
          "scalar": { "type": "number", "min": 0, "max": 130 }
        },
        "contact": {
          "kind": "Union",
          "discriminator": "type",
          "variants": {
            "email": {
              "kind": "Scalar",
              "required": true,
              "scalar": {
                "type": "string",
                "pattern": "^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$"
              }
            },
            "phone": {
              "kind": "Scalar",
              "required": true,
              "scalar": {
                "type": "string",
                "pattern": "^\\\\+?[0-9]{7,15}$"
              }
            }
          }
        },
        "dependents": {
          "kind": "List",
          "minItems": 0,
          "maxItems": 5,
          "item": {
            "kind": "Struct",
            "fields": {
              "name": { "kind": "Scalar", "scalar": { "type": "string" } },
              "age": { "kind": "Scalar", "scalar": { "type": "number", "min": 0 } }
            }
          }
        },
        "customer_id": {
          "kind": "Reference",
          "target": "Customer",
          "format": { "pattern": "^[A-Z0-9_-]+$" }
        }
      }
    }
  },

  "valid_meta_top_level_only": {
    "version": "1.0.0",
    "meta": {
      "label": "Projection title",
      "description": "Longer description",
      "hint": "A hint for UI",
      "tags": ["tag1", "tag2"],
      "examples": ["foo", 123, { "a": true }]
    },
    "root": {
      "kind": "Scalar",
      "scalar": { "type": "boolean" }
    }
  },

  "valid_reference_with_format": {
    "version": "1.0.0",
    "root": {
      "kind": "Reference",
      "target": "Account",
      "required": true,
      "format": {
        "pattern": "^acct_[0-9]+$",
        "minLength": 6,
        "maxLength": 32
      }
    }
  },

  "valid_union_with_default": {
    "version": "1.0.0",
    "root": {
      "kind": "Union",
      "discriminator": "type",
      "default": "email",
      "variants": {
        "email": {
          "kind": "Scalar",
          "scalar": { "type": "string", "pattern": "@" }
        },
        "phone": {
          "kind": "Scalar",
          "scalar": { "type": "string", "minLength": 7 }
        }
      }
    }
  },

  "valid_list_bounds": {
    "version": "1.0.0",
    "root": {
      "kind": "List",
      "minItems": 2,
      "maxItems": 2,
      "item": {
        "kind": "Struct",
        "fields": {
          "line1": { "kind": "Scalar", "scalar": { "type": "string", "minLength": 1 } },
          "line2": { "kind": "Scalar", "scalar": { "type": "string" } }
        },
        "required": ["line1"]
      }
    }
  },

  "invalid_missing_required_top_level": {
    "version": "1.0.0"
  },

  "invalid_unknown_node_kind": {
    "version": "1.0.0",
    "root": {
      "kind": "Map",
      "fields": {}
    }
  },

  "invalid_extra_property_on_node": {
    "version": "1.0.0",
    "root": {
      "kind": "Scalar",
      "scalar": { "type": "string" },
      "ui": { "widget": "textbox" }
    }
  },

  "invalid_struct_bad_field_name": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "first-name": { "kind": "Scalar", "scalar": { "type": "string" } }
      }
    }
  },

  "invalid_union_missing_discriminator": {
    "version": "1.0.0",
    "root": {
      "kind": "Union",
      "variants": {
        "a": { "kind": "Scalar", "scalar": { "type": "string" } }
      }
    }
  },

  "invalid_union_bad_variant_key": {
    "version": "1.0.0",
    "root": {
      "kind": "Union",
      "discriminator": "type",
      "variants": {
        "bad key": { "kind": "Scalar", "scalar": { "type": "string" } }
      }
    }
  },

  "invalid_list_missing_maxItems": {
    "version": "1.0.0",
    "root": {
      "kind": "List",
      "item": { "kind": "Scalar", "scalar": { "type": "string" } }
    }
  },

  "invalid_reference_format_extra_prop": {
    "version": "1.0.0",
    "root": {
      "kind": "Reference",
      "target": "Account",
      "format": {
        "pattern": "^acct_",
        "unknown": true
      }
    }
  },

  "invalid_scalar_constraints_wrong_shape": {
    "version": "1.0.0",
    "root": {
      "kind": "Scalar",
      "scalar": { "type": "string", "min": 1 }
    }
  },

  "invalid_node_meta_extra_prop": {
    "version": "1.0.0",
    "root": {
      "kind": "Scalar",
      "scalar": { "type": "string" },
      "meta": { "label": "x", "color": "red" }
    }
  },

  "valid_struct_with_relations": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "password": { "kind": "Scalar", "scalar": { "type": "string", "minLength": 8 } },
        "confirm_password": { "kind": "Scalar", "scalar": { "type": "string", "minLength": 8 } }
      },
      "required": ["password", "confirm_password"],
      "relations": [
        {
          "op": "eq",
          "left": "password",
          "right": "confirm_password",
          "label": "Passwords must match"
        }
      ]
    }
  },

  "valid_struct_with_date_relation": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "start_date": { "kind": "Scalar", "scalar": { "type": "string" } },
        "end_date": { "kind": "Scalar", "scalar": { "type": "string" } }
      },
      "relations": [
        {
          "op": "lt",
          "left": "start_date",
          "right": "end_date",
          "label": "Start date must be before end date"
        }
      ]
    }
  },

  "valid_struct_with_multiple_relations": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "min_value": { "kind": "Scalar", "scalar": { "type": "number" } },
        "current_value": { "kind": "Scalar", "scalar": { "type": "number" } },
        "max_value": { "kind": "Scalar", "scalar": { "type": "number" } }
      },
      "relations": [
        { "op": "lte", "left": "min_value", "right": "current_value", "label": "Current must be >= min" },
        { "op": "lte", "left": "current_value", "right": "max_value", "label": "Current must be <= max" },
        { "op": "lt", "left": "min_value", "right": "max_value", "label": "Min must be less than max" }
      ]
    }
  },

  "valid_struct_empty_relations": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "name": { "kind": "Scalar", "scalar": { "type": "string" } }
      },
      "relations": []
    }
  },

  "invalid_relation_unknown_operator": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "a": { "kind": "Scalar", "scalar": { "type": "number" } },
        "b": { "kind": "Scalar", "scalar": { "type": "number" } }
      },
      "relations": [
        { "op": "contains", "left": "a", "right": "b", "label": "Invalid op" }
      ]
    }
  },

  "invalid_relation_missing_label": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "a": { "kind": "Scalar", "scalar": { "type": "number" } },
        "b": { "kind": "Scalar", "scalar": { "type": "number" } }
      },
      "relations": [
        { "op": "eq", "left": "a", "right": "b" }
      ]
    }
  },

  "invalid_relation_extra_property": {
    "version": "1.0.0",
    "root": {
      "kind": "Struct",
      "fields": {
        "a": { "kind": "Scalar", "scalar": { "type": "number" } },
        "b": { "kind": "Scalar", "scalar": { "type": "number" } }
      },
      "relations": [
        { "op": "eq", "left": "a", "right": "b", "label": "Match", "custom": true }
